# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_API_MODE=mock
VITE_APP_NAME=Freight Chartering Intelligence Platform
VITE_APP_ENV=local

# Backend
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://freight_user:freight_password@localhost:5432/freight_intelligence
# Optional TimescaleDB feature store from freight-database/. It is separate from DATABASE_URL.
FREIGHT_DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5433/freight_db
CORS_ORIGINS=http://localhost:5173

# Local ML/data paths. Keep these outside browser-accessible folders.
MODEL_ROOT_PATH=./ml/models
MODEL_ARTIFACT_PATH=./ml/artifacts
MODEL_REGISTRY_PATH=./ml/registry/model_registry.json
DATA_ROOT_PATH=./data
MARKET_INTELLIGENCE_DATA_PATH=./data/features/market_intelligence
MLFLOW_TRACKING_URI=./ml/mlruns

# --- OPTIONAL: external blockchain anchoring (Polygon Amoy TESTNET). Leave empty to keep it disabled. ---
# Use a THROWAWAY test wallet only. Never commit a real key. Never put real funds in it.
AMOY_PRIVATE_KEY=
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# 0 = manual "Anchor now" button only. e.g. 30 = also anchor automatically every 30 minutes.
ANCHOR_INTERVAL_MINUTES=0
